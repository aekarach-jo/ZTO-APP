<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for android:allowBackup. Both transports are excluded
  because the app's session tokens live in flutter_secure_storage, whose
  ciphertext is bound to the originating device's keystore: restoring it onto a
  new device yields a file that cannot be decrypted, and the user lands in a
  half-signed-in state. Losing the backup just means signing in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
